{
  "name": "AI Lead Triage",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "new-lead", "responseMode": "onReceived"},
      "name": "New lead (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LEAD_TRIAGE_URL || 'http://lead-triage:8000' }}/leads",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {"timeout": 30000}
      },
      "name": "Triage with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{ $json.duplicate === false && $json.lead.category !== 'spam' }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true", "singleValue": true}
            }
          ],
          "combinator": "and"
        }
      },
      "name": "New and not spam?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {"__rl": true, "mode": "url", "value": "REPLACE_WITH_YOUR_SHEET_URL"},
        "sheetName": {"__rl": true, "mode": "name", "value": "Leads"},
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        }
      },
      "name": "Add row to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [720, -80]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{ $('Triage with AI').item.json.lead.urgency }}",
              "rightValue": "high",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, -80]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {"__rl": true, "mode": "name", "value": "#sales"},
        "text": "=Urgent lead: {{ $('Triage with AI').item.json.lead.summary }} ({{ $('Triage with AI').item.json.lead.email }})"
      },
      "name": "Alert in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1200, -160]
    }
  ],
  "connections": {
    "New lead (webhook)": {"main": [[{"node": "Triage with AI", "type": "main", "index": 0}]]},
    "Triage with AI": {"main": [[{"node": "New and not spam?", "type": "main", "index": 0}]]},
    "New and not spam?": {"main": [[{"node": "Add row to Google Sheet", "type": "main", "index": 0}], []]},
    "Add row to Google Sheet": {"main": [[{"node": "Urgent?", "type": "main", "index": 0}]]},
    "Urgent?": {"main": [[{"node": "Alert in Slack", "type": "main", "index": 0}], []]}
  },
  "settings": {"executionOrder": "v1"}
}
